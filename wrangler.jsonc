// Cloudflare Workers (Git orqali avtomatik deploy) sozlamasi
{
  "name": "maksudoff-uz",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    { "binding": "CONTENT", "id": "43c475797f584c25967ed11021998def" }
  ],
  "observability": { "enabled": true }
}
